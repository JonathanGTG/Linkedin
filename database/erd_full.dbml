Ref: lesson_progress.lesson_id > lessons.lesson_id
Ref: bookmarks.user_id > users.user_id
Ref: bookmarks.course_id > courses.course_id
Ref: bookmarks.lesson_id > lessons.lesson_id
Ref: notes.user_id > users.user_id
Ref: notes.course_id > courses.course_id
Ref: notes.lesson_id > lessons.lesson_id
