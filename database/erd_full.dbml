Ref: course_reviews.course_id > courses.course_id
Ref: review_votes.course_review_id > course_reviews.course_review_id
Ref: review_votes.user_id > users.user_id
Ref: discussion_threads.course_id > courses.course_id
Ref: discussion_threads.lesson_id > lessons.lesson_id
Ref: discussion_threads.user_id > users.user_id
Ref: discussion_posts.discussion_thread_id > discussion_threads.discussion_thread_id
Ref: discussion_posts.user_id > users.user_id
Ref: discussion_reactions.discussion_post_id > discussion_posts.discussion_post_id
Ref: discussion_reactions.user_id > users.user_id
Ref: quizzes.lesson_id > lessons.lesson_id
Ref: quiz_questions.quiz_id > quizzes.quiz_id
Ref: quiz_options.quiz_question_id > quiz_questions.quiz_question_id
Ref: quiz_attempts.quiz_id > quizzes.quiz_id
Ref: quiz_attempts.user_id > users.user_id
Ref: quiz_answers.quiz_attempt_id > quiz_attempts.quiz_attempt_id
Ref: quiz_answers.quiz_question_id > quiz_questions.quiz_question_id
Ref: quiz_answers.quiz_option_id > quiz_options.quiz_option_id
