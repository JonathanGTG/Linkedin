Ref: user_feed_items.user_id > users.user_id
Ref: notifications.user_id > users.user_id
Ref: notifications.notification_template_id > notification_templates.notification_template_id
Ref: email_outbox.user_id > users.user_id
Ref: push_tokens.user_id > users.user_id
Ref: audit_logs.actor_user_id > users.user_id
Ref: content_moderation_queue.reviewed_by > users.user_id
Ref: abuse_reports.reporter_user_id > users.user_id
